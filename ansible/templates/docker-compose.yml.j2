services:
  backend:
    image: "{{ ecr_registry }}/pocketpal-backend:{{ image_tag }}"
    container_name: pocketpal-backend
    ports:
      - "{{ backend_port }}:5000"
    environment:
      NODE_ENV: production
      PORT: 5000
    restart: unless-stopped

  frontend:
    image: "{{ ecr_registry }}/pocketpal-frontend:{{ image_tag }}"
    container_name: pocketpal-frontend
    ports:
      - "{{ frontend_port }}:5173"
    depends_on:
      - backend
    restart: unless-stopped
