# Do not copy installed dependencies into Docker
node_modules
server/node_modules

# Do not copy build output
dist
build

# Do not copy Git files
.git
.github

# Do not copy environment files or secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Do not copy logs
npm-debug.log
yarn-debug.log
yarn-error.log
*.log

# Do not copy editor/system files
.vscode
.idea
.DS_Store
Thumbs.db

# Do not copy Docker/documentation files into build context
Dockerfile
docker-compose.yml
README.md