aws_region = "us-east-1"

project_name = "pocketpal"
environment  = "production"

vpc_cidr                  = "10.0.0.0/16"
public_subnet_1_cidr      = "10.0.1.0/24"
public_subnet_2_cidr      = "10.0.2.0/24"
application_subnet_cidr   = "10.0.10.0/24"
database_subnet_1_cidr    = "10.0.20.0/24"
database_subnet_2_cidr    = "10.0.21.0/24"

instance_type    = "t3.micro"
root_volume_size = 10

ssh_key_name     = "pocketpal-course-key"
ssh_allowed_cidr = "YOUR_PUBLIC_IP/32"

frontend_port = 5173
backend_port  = 5000

db_name     = "pocketpal"
db_username = "pocketpal_admin"
db_password = "REPLACE_WITH_A_STRONG_PASSWORD"

additional_tags = {
  Course    = "Advanced-DevOps"
  Assignment = "Summative"
}